# ==============================================================================
# Security & Access Control Configuration
# Eri Nur Sofa Portfolio Enterprise Production Protection
# ==============================================================================

# 1. Disable Directory Browsing
Options -Indexes

# 2. Block direct web access to sensitive environment files, databases, and logs
<FilesMatch "(^\.env|^\.git|^\.htaccess|\.sqlite|\.db|\.sql|\.log|\.json)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# 3. Block access to protected backend folders
RedirectMatch 403 (?i)^/(data|\.git|api/logs|api/services|tests|scratch)/

# 4. Global Security Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 5. Enable Gzip Compression for Performance & SEO
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>
