# ==============================================================================
# WORLD-CLASS STANDARD .GITIGNORE FOR PROFESSIONAL SOFTWARE ENGINEERS
# Optimized for Web, Node.js, Frontend, PHP/XAMPP, Cloudflare, & Modern Tooling
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ENVIRONMENT & SENSITIVE SECRETS (CRITICAL - NEVER COMMIT SECRETS)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.sample
!.env.template
*.env
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
id_rsa
id_ed25519

# ------------------------------------------------------------------------------
# 2. OPERATING SYSTEMS ARTIFACTS
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

