# Protect internal service scripts and sensitive files
<FilesMatch "^(config\.php|.*\.env|.*\.log|.*\.sqlite|.*\.json)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Block access to services subdirectory
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^services/ - [F,L]
</IfModule>
